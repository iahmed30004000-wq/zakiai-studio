# انسخ هالملف لـ .env (cp .env.example .env) وعبّي القيم. ما ترفع .env لأي مكان ولا تحطه بمحادثة.
# كل القيم هون أمثلة فاضية — ما في أي توكن حقيقي.

# توكن الوصول للصناديق (مطلوب). ولّد واحد عشوائي بهالأمر على السيرفر وانسخ ناتجه هون:
#   openssl rand -hex 32
ENGINE_TOKEN=

# مكان الأوزان على السيرفر. كل نموذج بمجلد لحاله فيه model_index.json (صيغة diffusers): Qwen-Image، FLUX.1-schnell، Wan2.2-TI2V-5B-Diffusers…
# وملفات التكبير (Real-ESRGAN .pth) بمجلد فرعي اسمه upscale/. الصندوق بيلاقيهم لحاله وبيطلعوا بمكتبة النماذج. بيتركّب للقراءة فقط.
ENGINE_WEIGHTS_DIR=./models/engines

# دقائق الخمول قبل ما الصندوق يفرّغ النموذج من ذاكرة الكرت
IDLE_UNLOAD_MIN=10

# أقصى مدة فيديو (ثواني) بيقبلها الصندوق
MAX_SECONDS=8

# أقصى مدة صوت (ثواني) للموسيقى والمؤثرات (Stable Audio Open بيوصل لـ 47)
AUDIO_MAX_SECONDS=47

# أقصى دقة (عرض×ارتفاع بالبكسل). 0 = القيمة الجاهزة لكل نموذج. مثال: 399360 يعني 480×832
MAX_PIXELS=0

# سقف مساحة الصورة بعد التكبير (بكسل). الافتراضي 64 ميغابكسل
UPSCALE_MAX_PIXELS=64000000

# توفير ذاكرة الكرت: auto (الصندوق بيقرر) | model (دايماً أقل ذاكرة وأبطأ) | none (كله على الكرت)
ENGINE_OFFLOAD=auto

# كم دقيقة بنخلّي ملفات المهام المنتهية قبل ما تنحذف لحالها
OUTPUT_KEEP_MIN=120

# مستخدم السيرفر اللي بيكتب على library/ (بالأمر: id -u و id -g). غالباً 1000
APP_UID=1000
APP_GID=1000

# عبارة سر الخزنة المشفّرة لمفاتيح وتوكنات الاتصالات (16 حرف على الأقل). ولّد واحدة بـ: openssl rand -base64 24
# لو ضاعت أو اتغيّرت، المفاتيح المحفوظة بالخزنة (secrets/vault.enc) ما بتنفتح — بتعيد إدخالها. ما تحطها بغير هالملف.
VP_SECRETS_KEY=

# حارس الاستوديو (web/guard.py): الافتراضي بيقبل localhost و127.0.0.1 بس، وأي اسم تاني بيرجع 400.
# أضف أسماء إضافية (مفصولة بفاصلة) فقط لو بتدخل بغير نفق SSH، ومعك محوّل عكسي. غير هيك خلّيه فاضي.
VP_ALLOWED_HOSTS=
# مصادر (Origin) إضافية، فقط لو المحوّل العكسي بيغيّر ترويسة Host. مثال: https://studio.example.com
VP_ALLOWED_ORIGINS=
